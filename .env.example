# Copy this file to .env and fill in your real values
# NEVER commit the actual .env file — it's already in .gitignore

# MongoDB connection string (get from MongoDB Atlas)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/BusinessHub?retryWrites=true&w=majority

# Port the server runs on
PORT=5001

# AI features (optional — get from groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Admin Secret — used to create Admin accounts
# Choose a strong unique value. Anyone with this key can create an Admin.
ADMIN_SECRET=choose_a_strong_secret_here
